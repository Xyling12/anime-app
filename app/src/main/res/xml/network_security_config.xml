<?xml version="1.0" encoding="utf-8"?>
<!--
  Доверяем только системным корневым сертификатам.

  По умолчанию Android до API 24 доверял ещё и пользовательским CA, а на многих
  устройствах их можно доставить руками. Именно так работает перехват трафика
  через Burp/mitmproxy: злоумышленник ставит свой корневой сертификат и читает
  весь HTTPS, включая токен авторизации в заголовке Authorization.

  Исключение user-хранилища закрывает этот сценарий: приложение перестаёт
  доверять таким сертификатам и рвёт соединение вместо того, чтобы отдать данные.
  Отладочный оверрайд намеренно не добавлен — иначе debug-сборкой можно было бы
  снять дамп боевого трафика.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
